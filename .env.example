# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://srvtechnology.com"

# --- Contact form SMTP config (server.js) ---
# SMTP_USER: Gmail address used to send contact/quote form submissions.
SMTP_USER="info@srvtechnology.com"
# SMTP_PASS: Gmail App Password (NOT your regular Gmail password).
# Generate one at https://myaccount.google.com/apppasswords with 2FA enabled.
SMTP_PASS="MY_GMAIL_APP_PASSWORD"
# CONTACT_RECEIVER_EMAILS: comma-separated list of addresses that receive submissions.
CONTACT_RECEIVER_EMAILS="rishav@srvtechnology.com"
# PORT: port the local SMTP API server (server.js) listens on.
PORT=8787

# --- Blog CMS Admin Credentials ---
# ADMIN_USERNAME: Username for the blog CMS admin panel.
ADMIN_USERNAME="admin"
# ADMIN_PASSWORD: Strong password for the blog CMS admin panel (change immediately).
ADMIN_PASSWORD="Admin@123!"

# JWT_SECRET: Secret key for signing JWT tokens. Change to a random string in production.
JWT_SECRET="srv-blog-cms-secret-change-in-production"

# --- Cloudflare Turnstile CAPTCHA (bot protection on all contact/lead forms) ---
# Get both keys at https://dash.cloudflare.com/?to=/:account/turnstile — register
# srvtechnology.com (add localhost as an allowed domain too, for local dev).
# VITE_TURNSTILE_SITE_KEY: public site key, exposed to the browser (Vite frontend).
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAEDkZg5zSbnpL5hp"
# TURNSTILE_SECRET_KEY: backend-only secret used to verify tokens server-side. Never expose this.
TURNSTILE_SECRET_KEY="0x4AAAAAAEDkZpcxs_o_zisEioF7H0HBKgM"
# For local dev before you have real keys, Cloudflare publishes fixed test keys that
# always pass: site key "1x00000000000000000000AA", secret key "1x0000000000000000000000000000000AA".
